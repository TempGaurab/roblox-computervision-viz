--!strict
local TestKit = require("./lib/TestKit")
local Leaderboard = require("../src/server/Leaderboard")

local DEV = 100

return function(kit: TestKit.TestKit)
	kit.test("a streak only counts when it beats the best", function()
		local board = Leaderboard.new(DEV, 10)
		kit.equal(Leaderboard.recordStreak(board, 1, 3), true, "first best")
		kit.equal(Leaderboard.recordStreak(board, 1, 3), false, "equal")
		kit.equal(Leaderboard.recordStreak(board, 1, 2), false, "lower")
		kit.equal(Leaderboard.recordStreak(board, 1, 0), false, "a reset streak")
		kit.equal(Leaderboard.recordStreak(board, 1, 4), true, "higher")
		kit.equal(Leaderboard.rows(board)[1].best, 4, "best")
	end)

	kit.test("a streak of zero never makes the board", function()
		local board = Leaderboard.new(DEV, 10)
		kit.equal(Leaderboard.recordStreak(board, 1, 0), false, "zero")
		kit.equal(#Leaderboard.rows(board), 0, "empty")
	end)

	kit.test("test players with no real user ID never count", function()
		local board = Leaderboard.new(DEV, 10)
		kit.equal(Leaderboard.recordStreak(board, -1, 5), false, "negative")
		kit.equal(Leaderboard.recordStreak(board, 0, 5), false, "zero")
		kit.equal(#Leaderboard.rows(board), 0, "empty")
		kit.equal(next(Leaderboard.takeUnsaved(board)), nil, "nothing to save")
	end)

	kit.test("rows rank best first, break ties by user ID, and stop at the size", function()
		local board = Leaderboard.new(DEV, 3)
		Leaderboard.ingest(board, 5, 2)
		Leaderboard.ingest(board, 9, 7)
		Leaderboard.ingest(board, 3, 7)
		Leaderboard.ingest(board, 8, 1)
		local rows = Leaderboard.rows(board)
		kit.equal(#rows, 3, "size")
		kit.equal(rows[1].userId, 3, "tie goes to the lower ID")
		kit.equal(rows[1].rank, 1, "rank")
		kit.equal(rows[2].userId, 9, "second")
		kit.equal(rows[3].userId, 5, "third")
	end)

	kit.test("only new bests from play wait to be saved, and failures can be put back", function()
		local board = Leaderboard.new(DEV, 10)
		Leaderboard.ingest(board, 1, 5)
		kit.equal(next(Leaderboard.takeUnsaved(board)), nil, "stored bests aren't saved again")
		Leaderboard.recordStreak(board, 1, 4)
		kit.equal(next(Leaderboard.takeUnsaved(board)), nil, "below the stored best")

		Leaderboard.recordStreak(board, 1, 6)
		kit.equal(Leaderboard.takeUnsaved(board)[1], 6, "saved")
		kit.equal(next(Leaderboard.takeUnsaved(board)), nil, "only once")

		Leaderboard.markUnsaved(board, 1, 6)
		Leaderboard.recordStreak(board, 1, 7)
		Leaderboard.markUnsaved(board, 1, 6)
		kit.equal(Leaderboard.takeUnsaved(board)[1], 7, "a late failure doesn't lower it")
	end)

	kit.test("the developer is flagged, and has a best even outside the top", function()
		local board = Leaderboard.new(DEV, 1)
		kit.equal(Leaderboard.developerBest(board), nil, "none yet")
		Leaderboard.ingest(board, 1, 9)
		Leaderboard.ingest(board, DEV, 4)
		local rows = Leaderboard.rows(board)
		kit.equal(#rows, 1, "size")
		kit.equal(rows[1].isDeveloper, false, "not in the top")
		kit.equal(Leaderboard.developerBest(board), 4, "still pinned")

		Leaderboard.recordStreak(board, DEV, 10)
		kit.equal(Leaderboard.rows(board)[1].isDeveloper, true, "tagged in the top")
	end)

	kit.test("a lower value read from storage never lowers a best", function()
		local board = Leaderboard.new(DEV, 10)
		Leaderboard.recordStreak(board, 1, 8)
		kit.equal(Leaderboard.ingest(board, 1, 3), false, "stale read")
		kit.equal(Leaderboard.rows(board)[1].best, 8, "best")
	end)
end
